# ── DSM 연결 (자격증명은 여기 넣지 않습니다 — 로그인 시 입력) ─────────────
# NAS 주소(포트 제외). 예: http://192.168.0.10  또는  https://nas.example.com
DSM_BASE_URL=http://192.168.0.10
# DSM 웹 포트 (http 5000 / https 5001). 커스텀 포트면 그 값.
DSM_PORT=5000
# 자체서명 인증서(HTTPS)면 false 로 두어 TLS 검증을 건너뜁니다.
DSM_VERIFY_TLS=true
DSM_TIMEOUT_SECONDS=30

# ── 앱 세션 ───────────────────────────────────────────────────────────────
# 쿠키는 무작위 불투명 토큰이라 별도 서명 시크릿이 필요 없습니다.
SESSION_COOKIE_NAME=nasphoto_session
SESSION_TTL_SECONDS=28800
# DSM 리버스 프록시(HTTPS) 뒤에 둘 때 true 로 설정 → 쿠키 Secure 플래그.
COOKIE_SECURE=false

# ── 로그인 시도 제한 (선택) ───────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=600

# ── 저장소 ────────────────────────────────────────────────────────────────
# 로컬 개발 기본값. Docker에서는 compose가 /data/app.db 로 덮어씁니다.
SQLITE_PATH=./data/app.db

# ── CORS (개발 시 Vite dev 서버) ──────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── 프론트 정적 서빙 (운영) ───────────────────────────────────────────────
# 비워두면 API 전용 모드(개발은 Vite dev 서버 사용). Docker에서는 /app/static.
FRONTEND_DIST=
