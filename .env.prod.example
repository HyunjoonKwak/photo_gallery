# NAS 배포용 환경변수 예시 — NAS의 배포 디렉터리에 `.env`로 복사해 채웁니다.
# (docker-compose.prod.yml이 자동 로드. 자격증명은 넣지 않음 — 로그인 화면 입력)

# ── DSM 연결 ──────────────────────────────────────────────
DSM_BASE_URL=https://192.168.0.10
DSM_PORT=5001
DSM_VERIFY_TLS=false          # 자체서명 인증서면 false
DSM_TIMEOUT_SECONDS=30

# ── 앱 세션/보안 ─────────────────────────────────────────
# 운영 도메인은 NPM HTTPS 전용
COOKIE_SECURE=true
SESSION_TTL_SECONDS=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=600
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_TRUST_PROXY_HEADERS=true

# ── 운영 모드 ────────────────────────────────────────────
MOCK_MODE=false               # 운영에서는 반드시 false
# 첫 전환 배포는 반드시 legacy. Desk P0 파일럿 전에는 drain/curation 금지.
GALLERY_WRITE_MODE=legacy
# 기존 Gallery 동작을 보존하는 첫 배포값. Synology 날짜 백로그 정리 후 false.
GALLERY_LEGACY_DATE_REPAIR=true

# ── GHCR (deploy.sh가 사용) ──────────────────────────────
GHCR_USERNAME=hyunjoonkwak
IMAGE_TAG=latest
