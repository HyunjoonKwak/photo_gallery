# NAS 배포용 환경변수 예시 — NAS의 배포 디렉터리에 `.env`로 복사해 채웁니다.
# (docker-compose.prod.yml이 자동 로드. 자격증명은 넣지 않음 — 로그인 화면 입력)

# ── DSM 연결 ──────────────────────────────────────────────
DSM_BASE_URL=https://192.168.0.10
DSM_PORT=5001
DSM_VERIFY_TLS=false          # 자체서명 인증서면 false
DSM_TIMEOUT_SECONDS=30

# ── 앱 세션/보안 ─────────────────────────────────────────
# DSM 리버스 프록시(HTTPS) 뒤에 두면 true 권장
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=600

# ── 운영 모드 ────────────────────────────────────────────
MOCK_MODE=false               # 운영에서는 반드시 false

# ── GHCR (deploy.sh가 사용) ──────────────────────────────
GHCR_USERNAME=hyunjoonkwak
IMAGE_TAG=latest
